# Steam Web API key (https://steamcommunity.com/dev/apikey). Required.
# Never commit your real key or expose it to the frontend.
STEAM_API_KEY=your_steam_api_key_here

# Origin the backend accepts CORS requests from. Should match wherever the
# frontend is actually served from (the browser's origin).
# Dev (Angular): http://localhost:4200
# Prod-like Docker (nginx): http://localhost:8080
FRONTEND_ORIGIN=http://localhost:4200

# Rate limiting (protects your Steam Web API quota).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Shared secret for admin routes (GET /api/v1/cache/clear, GET /api/v1/library/refresh).
# Send it as the X-Admin-Key header. Required in production (routes 404 if unset).
# ADMIN_API_KEY=generate-a-long-random-secret

# Directory for daily-rotated request logs (kept at most 9 days). Unset logs to
# stdout. The production Docker image sets this to /app/logs.
# LOG_DIR=./logs
