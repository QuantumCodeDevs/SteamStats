{
  "name": "backend",
  "version": "0.4.2",
  "description": "SteamStats API - securely bridges the frontend to the Steam Web API and Steam Store API.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dump:openapi": "tsx src/scripts/dump-openapi.ts",
    "lint": "eslint src",
    "format:check": "prettier --check src",
    "format": "prettier --write src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.4",
    "fastify-plugin": "^5.0.1",
    "lru-cache": "^11.1.0",
    "pino-roll": "^4.0.0",
    "typebox": "^1.3.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.12"
  }
}
