                              },
                              "localizedName": {
                                "type": "string"
                              },
                              "archived": {
                                "type": "number"
                              },
                              "hidden": {
                                "type": "number"
                              }
                            },
                            "additionalProperties": true
                          }
                        }
                      },
                      "additionalProperties": false
                    },
                    "metacritic": {
                      "type": "object",
                      "required": [
                        "score",
                        "url"
                      ],
                      "properties": {
                        "score": {
                          "type": "number"
                        },
                        "url": {
                          "type": "string"
