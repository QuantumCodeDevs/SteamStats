    "/games/{appId}": {
      "get": {
        "operationId": "getGameDetails",
        "tags": [
          "games"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "appId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "appId",
                    "name",
                    "isFree",
                    "requiredAge",
                    "headerImage",
                    "capsuleImage",
                    "shortDescription",
                    "description",
                    "developers",
                    "publishers",
                    "releaseDate",
                    "platforms",
                    "genres",
                    "categories",
                    "screenshots"
                  ],
                  "properties": {
                    "appId": {
                      "type": "number"
                    },
                    "name": {
                      "type": "string"
                    },
                    "isFree": {
                      "type": "boolean"
                    },
                    "requiredAge": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        }
                      ]
                    },
                    "controllerSupport": {
                      "type": "string"
                    },
                    "headerImage": {
                      "type": "string"
                    },
                    "capsuleImage": {
                      "type": "string"
                    },
                    "shortDescription": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "developers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "publishers": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "releaseDate": {
                      "type": "object",
                      "required": [
                        "comingSoon",
                        "date"
                      ],
                      "properties": {
                        "comingSoon": {
                          "type": "boolean"
                        },
                        "date": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    "price": {
                      "type": "object",
                      "required": [
                        "currency",
                        "initial",
                        "final",
                        "discountPercent",
                        "initialFormatted",
                        "finalFormatted"
                      ],
                      "properties": {
                        "currency": {
                          "type": "string"
                        },
                        "initial": {
                          "type": "number"
                        },
                        "final": {
                          "type": "number"
                        },
                        "discountPercent": {
                          "type": "number"
                        },
                        "initialFormatted": {
                          "type": "string"
                        },
                        "finalFormatted": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    },
                    "platforms": {
                      "type": "object",
                      "required": [
                        "windows",
                        "mac",
                        "linux"
                      ],
                      "properties": {
                        "windows": {
                          "type": "boolean"
                        },
                        "mac": {
                          "type": "boolean"
                        },
                        "linux": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false
                    },
                    "genres": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "description"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "description"
                        ],
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "description": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "screenshots": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "thumbnail",
                          "full"
                        ],
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "thumbnail": {
                            "type": "string"
                          },
                          "full": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "achievements": {
                      "type": "object",
                      "required": [
                        "total",
                        "highlighted"
                      ],
                      "properties": {
                        "total": {
                          "type": "number"
                        },
                        "highlighted": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
