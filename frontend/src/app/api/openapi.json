{
  "openapi": "3.0.3",
  "info": {
    "title": "SteamStats API",
    "description": "API for Steam profile statistics, libraries, and wishlist data",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/profile/{steamId}": {
      "get": {
        "operationId": "getProfile",
        "tags": [
          "profile"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^7656119\\d{10}$"
            },
            "in": "path",
            "name": "steamId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "steamId",
                    "personaName",
                    "profileUrl",
                    "avatar",
                    "avatarMedium",
                    "avatarFull",
                    "personaState",
                    "visibility"
                  ],
                  "properties": {
                    "steamId": {
                      "type": "string"
                    },
                    "personaName": {
                      "type": "string"
                    },
                    "profileUrl": {
                      "type": "string"
                    },
                    "avatar": {
                      "type": "string"
                    },
                    "avatarMedium": {
                      "type": "string"
                    },
                    "avatarFull": {
                      "type": "string"
                    },
                    "personaState": {
                      "anyOf": [
                        {
                          "type": "number",
                          "enum": [
                            0
                          ]
                        },
                        {
                          "type": "number",
                          "enum": [
                            1
                          ]
                        },
                        {
                          "type": "number",
                          "enum": [
                            2
                          ]
                        },
                        {
                          "type": "number",
                          "enum": [
                            3
                          ]
                        },
                        {
                          "type": "number",
                          "enum": [
                            4
                          ]
                        },
                        {
                          "type": "number",
                          "enum": [
                            5
                          ]
                        },
                        {
                          "type": "number",
                          "enum": [
                            6
                          ]
                        }
                      ]
                    },
                    "visibility": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "public"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "private"
                          ]
                        }
                      ]
                    },
                    "lastLogoffAt": {
                      "type": "number"
                    },
                    "createdAt": {
                      "type": "number"
                    },
                    "countryCode": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "error",
                    "message"
                  ],
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/profile/resolve": {
      "post": {
        "operationId": "resolveSteamId",
        "tags": [
          "profile"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "input"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 256
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "steamId"
                  ],
                  "properties": {
                    "steamId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "error",
                    "message"
                  ],
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/library/{steamId}": {
      "get": {
        "operationId": "getLibrary",
        "tags": [
          "library"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^7656119\\d{10}$"
            },
            "in": "path",
            "name": "steamId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "games",
                    "stats"
                  ],
                  "properties": {
                    "games": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "appId",
                          "name",
                          "playtimeForeverMinutes",
                          "playtimeRecentMinutes",
                          "iconUrl",
                          "headerUrl"
                        ],
                        "properties": {
                          "appId": {
                            "type": "number"
                          },
                          "name": {
                            "type": "string"
                          },
                          "playtimeForeverMinutes": {
                            "type": "number"
                          },
                          "playtimeRecentMinutes": {
                            "type": "number"
                          },
                          "iconUrl": {
                            "type": "string"
                          },
                          "headerUrl": {
                            "type": "string"
                          },
                          "lastPlayedAt": {
                            "type": "number"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "stats": {
                      "type": "object",
                      "required": [
                        "totalGames",
                        "totalPlaytimeMinutes",
                        "mostPlayedGame",
                        "recentlyPlayedCount"
                      ],
                      "properties": {
                        "totalGames": {
                          "type": "number"
                        },
                        "totalPlaytimeMinutes": {
                          "type": "number"
                        },
                        "mostPlayedGame": {
                          "type": "object",
                          "required": [
                            "appId",
                            "name",
                            "playtimeForeverMinutes",
                            "playtimeRecentMinutes",
                            "iconUrl",
                            "headerUrl"
                          ],
                          "properties": {
                            "appId": {
                              "type": "number"
                            },
                            "name": {
                              "type": "string"
                            },
                            "playtimeForeverMinutes": {
                              "type": "number"
                            },
                            "playtimeRecentMinutes": {
                              "type": "number"
                            },
                            "iconUrl": {
                              "type": "string"
                            },
                            "headerUrl": {
                              "type": "string"
                            },
                            "lastPlayedAt": {
                              "type": "number"
                            }
                          },
                          "additionalProperties": false,
                          "nullable": true
                        },
                        "recentlyPlayedCount": {
                          "type": "number"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "statusCode",
                    "error",
                    "message"
                  ],
                  "properties": {
                    "statusCode": {
                      "type": "number"
                    },
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
